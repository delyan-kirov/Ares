$ @mod MAIN

#-
 - \info Combined test runner: import every example module (qualified) and run its
		$ test (0 = pass). `check` prints "<mod> ok" / "<mod> FAILED" for every module
		as it runs; every test runs regardless of earlier failures (no abort). Exit
		code = number of failing modules.
 -#

#- Imports -#

$ @import ARESxALGO
$ @import EXCEPTIONS
$ @import ARESxIO
$ @import ARESxPATH
$ @import ARESxSTR
$ @import ARESxVEC

#- Utils -#

$ check : @Str -> @Int -> <@IO> @Int = \name t =>
    if t == 0 =>
        println ("\x1b[1;32mOK\x1b[0m " ++ name); 0
    else
        println ("\x1b[1;31mERR\x1b[0m " ++ name); 1

# A module tests/EXCEPTIONS.ares skips here, reported so the output says so.
$ skip : @Str -> @Str -> <@IO> @Int = \name reason =>
    println ("\x1b[1;33mSKIP\x1b[0m " ++ name ++ " (" ++ reason ++ ")"); 0

$ excluded_tests : @Vec @Str = ["STDLIB_IO", "STDLIB_ASYNC_IO", "STDLIB_CHANNELS", "STDLIB_STM"]

# Every example, less the ones tests/EXCEPTIONS.ares says this platform cannot run.
$ modules : {} -> <@Meta, @IO> @Vec @Str =
    filter (\m => !(EXCEPTIONS.skipped TARGET.os m))
        (fmap ARES.strip_ext (filter (\f => ends_with ".ares" f) (read_dir "examples")))

$ check_call : @Str -> @Str = \m =>
    if ARES.contains_by ARES.eq m excluded_tests
    # check "whatever" whatever.test
    =>
        "check \"?(m)\" (?(m).test {})"
    else
        "check \"?(m)\" ?(m).test"

$ skip_call : EXCEPTIONS.Exception -> @Str = \e => "skip \"?(e.module)\" \"?(e.reason)\""

#- Build -#

$ @build : {} -> <@Meta, @IO> @Code =
    let ms = modules {} in
    let includes = concat (fmap (\m => "$ @import ?(m)\n") ms) in
    let main = "$ @main : @Vec @Str -> <@IO> @Int = \\args => 0"
        ++ concat (fmap (\m => " + \n\t" ++ check_call m) ms)
        ++ concat (fmap (\e => " + \n\t" ++ skip_call e) (EXCEPTIONS.on TARGET.os)) in
    @code <| includes ++ "\n" ++ main
