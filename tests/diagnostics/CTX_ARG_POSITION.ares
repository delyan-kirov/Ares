$ @mod CTX_ARG_POSITION

# An explicit `@ctx` argument goes where its parameter stands in the signature.
$ late : @ctx {t: @Type} -> t -> @ctx {d: IEq t} -> t -> Bool = \x y => d.eq x y
$ r : Bool = late @ctx {.d = impl_IEq_for_int} 1 2  #~ error[TYPE_MISMATCH]: `@ctx` field `d` of `late` goes after 1 explicit argument(s), not 0
