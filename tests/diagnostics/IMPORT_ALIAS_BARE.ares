$ @mod IMPORT_ALIAS_BARE

$ @import A = ARESxALGO
$ @import V = ARESxVEC
$ @import M = ARESxMAP

$ v : @Vec @Int = V.push 1 (A.new {})
$ n : @Vec @Int = push 2 v  #~ error[TYPE_UNBOUND]: unbound name `push`
$ m : @Vec @Int = ARES.push 2 v  #~ error[UNKNOWN_MODULE]: no module or effect `ARES` is in scope
$ c : @Int = let e : Map @Int @Int = A.new {} in A.len e  #~ error[TYPE_UNBOUND]: type `Map` is imported qualified-only
