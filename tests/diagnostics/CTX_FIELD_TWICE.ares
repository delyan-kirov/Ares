$ @mod CTX_FIELD_TWICE

# A field name is unique across a signature's `@ctx` parameters.
$ f : @ctx {t: @Type, d: IEq t} -> t -> @ctx {d: IOrd t} -> t -> Bool = \x y => d.lt x y  #~ error[DUPLICATE_SYMBOL]: `d` is bound twice in this signature
$ g : @ctx {t: @Type, t: IEq t} -> t -> Bool = \x => t.eq x x  #~ error[DUPLICATE_SYMBOL]: `t` is bound twice in this signature
