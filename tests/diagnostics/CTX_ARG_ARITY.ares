$ @mod CTX_ARG_ARITY

# An explicit `@ctx` argument and a `(t: @Type)` argument are elaborated as a
# written type is (#618): a declared type takes all of its parameters.
$ Box : (t: @Type) -> @Type = @struct val: t,
$ first : @ctx {t: @Type} -> t -> t -> t = \x _ => x
$ ident : (t: @Type) -> t -> t = \x => x
$ a : @Int = first @ctx {.t = Box} 1 2  #~ error[TYPE_MISMATCH]: type `Box` takes 1 parameter(s) but 0 were given
$ b : @Int = ident (Box @Int @Int) 1  #~ error[TYPE_MISMATCH]: type `Box` takes 1 parameter(s) but 2 were given
