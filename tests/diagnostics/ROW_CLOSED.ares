$ @mod ROW_CLOSED

# A closed row admits exactly its own labels.
$ Log : @Effect = log : @Str -> {},
$ Gpu : @Effect = draw : @Int -> {},
$ Net : @Effect = fetch : @Int -> @Int,

$ frame : @Int -> <Gpu, Log> @Int = \x =>
    fetch x #~ error[TYPE_MISMATCH]: effect `Net` is performed but not handled
