$ @mod MAIN

# \file LOGO.ares
# \info Generates the Ares marks. The logo is a hoplite in black-figure
#       silhouette, lunging forward with his spear raised overhand, cape
#       flowing back, a round shield with a rim line on his arm: near-black
#       with a gold shield on light grounds, all gold on dark ones, where a
#       thin cut separates the shield from the body. The icon is the same
#       soldier as hand-fitted pixel sprites, 16 and 32 px, and the lockups set
#       him beside ARES and the tagline in Cinzel, an inscriptional Roman
#       capital. `social` is the repository's 1280x640 preview card. `spear`
#       and `spear-shield` are the sprites the web playground throws across
#       its background, a dory flying right, the second carrying a shield seen
#       edge-on.
#
#       The drawing strategy: nothing is stroked. A design is a stack of
#       layers over an optional background, each a color and a set of figures.
#       A layer covers a point when the point lies inside an odd number of its
#       figures (the even-odd rule), so every edge in the picture is an exact
#       boundary. A colorless layer erases what is under it. Figures are ovals,
#       polygons, and closed cubic Bezier paths, which the SVG keeps as curves
#       and the raster flattens. The same layers are written as vector SVG and
#       rendered to a raster that ffmpeg scales down to any PNG widths asked
#       for. Letters are read from Cinzel's TrueType outlines and written as
#       paths, so no font is needed to view them.
#
#           ares build tools/LOGO.ares
#           tools/ares-artifacts/LOGO [design [out.svg [out.png width]...]]
#
#       With no arguments it writes the repository's copies, listed in
#       `assets`. An empty out.svg writes only the PNGs. Only the PNGs need
#       ffmpeg; the lockups and `social` need the directory of Cinzel's .ttf
#       files in ARES_FONT_CINZEL, which the dev shells set.

$ @import ARESxALGO
$ @import ARESxSTR
$ @import ARESxIO
$ @import ARESxMATH
$ @import ARESxVEC
$ @import ARESxOPT

$ Rgb : @Type = @struct
    r: @Int,
    g: @Int,
    b: @Int,

$ Point : @Type = { Real, Real }

# A curve keeps its numbers for the SVG, x0 y0 and then six a cubic segment
# (two control points and the end), and its flattened corners for the raster.
$ Figure : @Type = @union
    Oval: { cx: Real, cy: Real, rx: Real, ry: Real },
    Poly: { corners: @Vec Point, lo: Point, hi: Point },
    Curve: { nums: @Vec Real, corners: @Vec Point, lo: Point, hi: Point },

# `name` becomes the layer's class in the SVG, so a page that inlines the logo
# can style or animate its parts.
$ Layer : @Type = @struct
    name: @Str,
    color: Opt Rgb,
    figures: @Vec Figure,

# A design's coordinates run from (0, 0) at the top left to (width, height).
# The background lies under every layer, erasers included. `style` is CSS
# the SVG carries, for a design that switches with the color scheme.
$ Design : @Type = @struct
    width: Real,
    height: Real,
    background: Opt Rgb,
    layers: @Vec Layer,
    style: @Str,

# The gold of the shield, the black of black-figure pottery, and the near-black
# the dark assets stand on. Crimson is the playground spears' shaft.
$ gold : Rgb = Rgb.{ .r = 217, .g = 164, .b = 62 }
$ ink : Rgb = Rgb.{ .r = 34, .g = 25, .b = 21 }
$ night : Rgb = Rgb.{ .r = 21, .g = 17, .b = 14 }
$ crimson : Rgb = Rgb.{ .r = 179, .g = 32, .b = 46 }

$ box : Real -> Real -> Real -> Real -> Figure = \x0 y0 x1 y1 =>
    poly [{ x0, y0 }, { x1, y0 }, { x1, y1 }, { x0, y1 }]

$ bounds : @Vec Point -> { Point, Point } = \ps =>
    let lo = fold (\b p => { ARES.min b.0 p.0, ARES.min b.1 p.1 }) (@vec_get ps 0) ps in
    let hi = fold (\b p => { ARES.max b.0 p.0, ARES.max b.1 p.1 }) (@vec_get ps 0) ps in
    { lo, hi }

# A polygon with its bounding box, which lets the raster skip it at a glance
# for the many points nowhere near it.
$ poly : @Vec Point -> Figure = \ps => let bb = bounds ps in Figure.Poly.{ ps, bb.0, bb.1 }

# A closed path of cubic segments, each flattened to eight chords.
$ curve : @Vec Real -> Figure = \ns =>
    let v = \i => @vec_get ns i in
    let segment =
        \acc k =>
            let o = 6 * k in
            fold (\out j =>
                let t = real_of_int j / 8.0 in
                let u = 1.0 - t in
                let w0 = u * u * u in
                let w1 = 3.0 * u * u * t in
                let w2 = 3.0 * u * t * t in
                let w3 = t * t * t in
                @vec_push
                    out {
                        w0 * v o + w1 * v (o + 2) + w2 * v (o + 4) + w3 * v (o + 6),
                        w0 * v (o + 1) + w1 * v (o + 3) + w2 * v (o + 5) + w3 * v (o + 7)
                    }) acc (fmap (\j => j + 1) (upto 8))
    in
    let ps = fold segment [{ v 0, v 1 }] (upto ((@vec_len ns - 2) / 6)) in
    let bb = bounds ps in
    Figure.Curve.{ ns, ps, bb.0, bb.1 }

# A curve from its numbers written as whole ten-thousandths of the unit
# square, separated by spaces.
$ curve_of : @Str -> Figure = \s => curve
    (
        fmap (\w => real_of_int (from_str w |> \ | Opt.Some.{ k } => k | _ => 0) / 10000.0)
            (filter (\w => w != "") (ARES.split " " s))
    )

$ disc : Real -> Real -> Real -> Figure = \x y r => Figure.Oval.{ x, y, r, r }

# A figure scaled by `s` about the origin, then moved by (dx, dy).
$ place : Real -> Real -> Real -> Figure -> Figure = \dx dy s f =>
    f |> \
        | Figure.Oval.{ x, y, rx, ry } => Figure.Oval.{ dx + s * x, dy + s * y, s * rx, s * ry }
        | Figure.Poly.{ ps, _, _ }     => poly (fmap (\p => { dx + s * p.0, dy + s * p.1 }) ps)
        | Figure.Curve.{ ns, _, _, _ } => curve
            (
                fmap (\i => let x = @vec_get ns i in if i % 2 == 0 => dx + s * x else dy + s * x)
                    (upto (@vec_len ns))
            )

$ place_layer : Real -> Real -> Real -> Layer -> Layer = \dx dy s l =>
    Layer.{ l.name, l.color, fmap (place dx dy s) l.figures }

$ upto : @Int -> @Vec @Int = \n =>
    let go = \i acc => if i == n => acc else go (i + 1) (@vec_push acc i) in go 0 (@vec_new {})

# ---- the hoplite ----

# His outline in the unit square, drawn from back to front: the spear (shaft,
# then head), the cape, the legs and feet, torso, the raised arm and its fist,
# the neck, the helmet and its crest. Each piece is a layer of its own, since
# pieces overlap and the even-odd rule would cancel the overlaps in one layer.
# Then one eraser cuts the eye, the gap between crest and dome, and the fold
# in the cape; the stalk that carries the crest goes back over the gap.
# `kind` is "fill", "cut" or "stalk".
$ Part : @Type = { @Str, @Str, @Vec Figure }

$ spear_shaft : Part = {
    "spear",
    "fill",
    [
        curve_of
            (
                "916 568 916 568 7969 1683 7969 1683 7969 1683 8008 1442 8008 1442 "
                    ++ "8008 1442 954 327 954 327"
            ),
    ]
}

