# The shield, the rim line inside it, and on dark grounds the cut around it.
$ shield_x : Real = 0.6179
$ shield_y : Real = 0.5488
$ shield_r : Real = 0.1870
$ rim_r : Real = 0.82 * shield_r
$ rim_w : Real = 0.05 * shield_r
$ shield_gap : Real = 0.0142

# On a dark ground the figure is gold, like the shield, so a cut keeps them
# apart; the rim line stays dark in both.
$ hoplite : @Bool -> @Vec Layer = \dark =>
    let body = if dark => gold else ink in
    let pieces =
        fmap (\p =>
            p.1 |> \
                | "cut" => Layer.{ p.0, Opt.None, p.2 }
                | _     => Layer.{ p.0, Opt.Some.{ body }, p.2 }) hero_parts
    in
    let cut =
        if dark =>
            [Layer.{ "channel", Opt.None, [disc shield_x shield_y (shield_r + shield_gap)] }]
        else
            []
    in
    concat [
        pieces,
        cut,
        [
            Layer.{ "shield", Opt.Some.{ gold }, [disc shield_x shield_y shield_r] },
            Layer.{
                "shield",
                Opt.Some.{ ink },
                [
                    disc shield_x shield_y (rim_r + rim_w / 2.0),
                    disc shield_x shield_y (rim_r - rim_w / 2.0)
                ]
            },
        ],
    ]

$ square : Opt Rgb -> @Vec Layer -> Design = \bg layers =>
    Design.{ .width = 1.0, .height = 1.0, .background = bg, .layers = layers, .style = "" }

# The gold hoplite on the dark ground, a margin around him: the touch icon
# and the editor extension's badge.
$ badge : Design = square Opt.Some.{ night } (fmap (place_layer 0.08 0.08 0.84) (hoplite @true))

# ---- the icon: the soldier as pixels ----

# Hand-fitted sprites, a row a string: `K` the figure, `G` the shield, `R` its
# rim line, `.` clear. At 16 px the rim is dropped and the spear is one pixel.
$ soldier_16 : @Vec @Str = [
    "KKKKK...........",
    ".....KKKKKKKK...",
    ".....KK....KKKKK",
    ".....K..KK.KK...",
    ".....K.KKKK.....",
    "....K...KKKK....",
    "....KKKKKK.K....",
    "..KKKKKKKGGG....",
    ".KKKKKKKGGGGG...",
    "...KKKKGGGGGGG..",
    "..KKKKKGGGGGGG..",
    "....KKKGGGGGGGK.",
    "......KKGGGGG.K.",
    "......KK.GGG.KK.",
    ".....KK......KK.",
    "....KKKK.....KKK",
]

$ soldier_32 : @Vec @Str = [
    "KKKKKKK.........................",
    "KKKKKKKKKKKKKK.........KK.......",
    ".......KKKKKKKKKKKKKK..KKKK.....",
    "..........KKK.KKKKKKKKKKKKKKKK..",
    "..........KK.........KKKKKKKKKKK",
    "..........KK...KKKKK...KKKKKK...",
    "..........KK..KKKKKKK..KK.......",
    "..........KK.KKK.KKKKK..........",
    "..........KK....KKKKKKK.........",
    ".........KKKK...KKKK..K.........",
    "..........KKKKK.KKKKKKKK........",
    "...........KKKKK.KKKKK.K........",
    ".......KKKKKKKKKK.GGGGG.........",
    "....KKKKKKKKKKKKGGRRRRRGG.......",
    "..KKKKKKKKKKKKKGGRGGGGGRGG......",
    ".KKKKKKKKKKKKKKGRGGGGGGGRG......",
    ".....KKKKKKKKKGRGGGGGGGGGRG.....",
    "....KKKKKKKKKKGRGGGGGGGGGRG.....",
    "...KKKKKKKKKKKGRGGGGGGGGGRG.....",
    "..KKKKKKKKKKKKGRGGGGGGGGGRG.....",
    "......KKKKKKKKGRGGGGGGGGGRG.....",
    ".........KKKKKKGRGGGGGGGRG......",
    "............KKKGGRGGGGGRGG......",
    "..............KKGGRRRRRGGKKK....",
    ".............KKKKKGGGGGKKKKKK...",
    "............KKKK.........KKKK...",
    "...........KKKK..........KKKK...",
    "..........KKKK...........KKK....",
    ".........KKKK............KKK....",
    "........KKKK.............KKK....",
    "........KKKK.............KKKK...",
    ".........KKKKK...........KKKKKK.",
]

$ code_k : @Int = 75
$ code_g : @Int = 71
$ code_r : @Int = 82
$ code_clear : @Int = 46

$ sprite_at : @Vec @Str -> @Int -> @Int -> @Int = \rs x y =>
    let n = @vec_len rs in
    if x < 0 || y < 0 || x >= n || y >= n => code_clear else @array_get (@vec_get rs y) x

# The dark version: where the figure touches the shield (or its rim), even at
# a corner, its pixel is cleared, the sprite's cut.
$ gapped : @Vec @Str -> @Vec @Str = \rs =>
    let n = @vec_len rs in
    let shieldy = \x y => let c = sprite_at rs x y in c == code_g || c == code_r in
    let near =
        \x y =>
            shieldy (x - 1) (y - 1)
                || shieldy x (y - 1)
                || shieldy (x + 1) (y - 1)
                || shieldy (x - 1) y
                || shieldy (x + 1) y
                || shieldy (x - 1) (y + 1)
                || shieldy x (y + 1)
                || shieldy (x + 1) (y + 1)
    in
    fmap (\y =>
        fold (\s x =>
            let c = sprite_at rs x y in
            @array_push s (if c == code_k && near x y => code_clear else c)) "" (upto n)) (upto n)

# The pixels of `code` as boxes in the unit square, a run of them a box.
$ pixels : @Vec @Str -> @Int -> @Vec Figure = \rs code =>
    let n = @vec_len rs in
    let side = 1.0 / real_of_int n in
    flat_map (\y =>
        let run =
            \x start acc =>
                let on = x < n && sprite_at rs x y == code in
                if on && start < 0 =>
                    run (x + 1) x acc
                else if on =>
                    run (x + 1) start acc
                else
                    let acc2 =
                        if start < 0 =>
                            acc
                        else
                            @vec_push acc
                                (
                                    box (side * real_of_int start) (side * real_of_int y)
                                        (side * real_of_int x) (side * real_of_int (y + 1))
                                )
                    in
                    if x >= n => acc2 else run (x + 1) (0 - 1) acc2
        in
        run 0 (0 - 1) (@vec_new {})) (upto n)

$ sprite_layers : @Str -> @Bool -> @Vec @Str -> @Vec Layer = \name dark rs =>
    let src = if dark => gapped rs else rs in
    filter (\l => @vec_len l.figures > 0) [
        Layer.{ name, Opt.Some.{ if dark => gold else ink }, pixels src code_k },
        Layer.{ name, Opt.Some.{ gold }, pixels src code_g },
        Layer.{ name, Opt.Some.{ ink }, pixels src code_r },
    ]

$ sprite : @Bool -> @Vec @Str -> Design = \dark rs =>
    square Opt.None (sprite_layers "soldier" dark rs)

# The favicon carries both versions and shows the one for the color scheme.
$ scheme_css : @Str =
    ".dark{display:none}@media (prefers-color-scheme:dark){.light{display:none}.dark{display:inline}}"

$ favicon : Design = Design.{
    .width = 1.0,
    .height = 1.0,
    .background = Opt.None,
    .layers = concat [
        sprite_layers "light" @false soldier_16,
        sprite_layers "dark" @true soldier_16
    ],
    .style = scheme_css,
}

# ---- letters: Cinzel's TrueType outlines ----

# A TrueType font: its bytes and where the tables the outlines need begin.
$ Font : @Type = @struct
    bytes: @Str,
    cmap: @Int,
    hmtx: @Int,
    metrics: @Int,
    loca: @Int,
    glyf: @Int,
    long_loca: @Bool,
    cap: Real,

$ u8 : @Str -> @Int -> @Int = \b i => @array_get b i
$ u16 : @Str -> @Int -> @Int = \b i => u8 b i * 256 + u8 b (i + 1)
$ i16 : @Str -> @Int -> @Int = \b i => let v = u16 b i in if v >= 32768 => v - 65536 else v
$ u32 : @Str -> @Int -> @Int = \b i => u16 b i * 65536 + u16 b (i + 2)

# Whether bit `mask` (a power of two) is set in `v`.
$ bit : @Int -> @Int -> @Bool = \v mask => (v / mask) % 2 == 1

# Where the table tagged `tag` begins, 0 when the font has none.
$ table : @Str -> @Str -> @Int = \b tag =>
    let n = u16 b 4 in
    let go =
        \i =>
            if i == n =>
                0
            else
                let rec = 12 + 16 * i in
                if @array_slice b rec (rec + 4) == tag => u32 b (rec + 8) else go (i + 1)
    in
    go 0

# The Windows Unicode cmap, format 4, which every TrueType font carries.
$ unicode_cmap : @Str -> @Int -> @Int = \b cmap =>
    let n = u16 b (cmap + 2) in
    let go =
        \i =>
            if i == n =>
                0
            else
                let rec = cmap + 4 + 8 * i in
                if u16 b rec == 3 && u16 b (rec + 2) == 1 => cmap + u32 b (rec + 4) else go (i + 1)
    in
    go 0

$ load_font : @Str -> <@IO> Opt Font = \path =>
    read_file path |> \
        | Opt.None => Opt.None
        | Opt.Some.{ b } =>
            let head = table b "head" in
            let os2 = table b "OS/2" in
            Opt.Some.{
                Font.{
                    .bytes = b,
                    .cmap = unicode_cmap b (table b "cmap"),
                    .hmtx = table b "hmtx",
                    .metrics = u16 b (table b "hhea" + 34),
                    .loca = table b "loca",
                    .glyf = table b "glyf",
                    .long_loca = i16 b (head + 50) == 1,
                    .cap = real_of_int (i16 b (os2 + 88)),
                }
            }

# The glyph for character code `c` in a format 4 cmap, 0 (the missing glyph)
# when there is none.
$ glyph_index : Font -> @Int -> @Int = \f c =>
    let b = f.bytes in
    let segs = u16 b (f.cmap + 6) / 2 in
    let ends = f.cmap + 14 in
    let starts = ends + 2 * segs + 2 in
    let delta_at = starts + 2 * segs in
    let ranges = delta_at + 2 * segs in
    let go =
        \i =>
            if i == segs =>
                0
            else if u16 b (ends + 2 * i) < c =>
                go (i + 1)
            else
                let start = u16 b (starts + 2 * i) in
                let delta = u16 b (delta_at + 2 * i) in
                let range = u16 b (ranges + 2 * i) in
                if c < start =>
                    0
                else if range == 0 =>
                    (c + delta) % 65536
                else
                    let g = u16 b (ranges + 2 * i + range + 2 * (c - start)) in
                    if g == 0 => 0 else (g + delta) % 65536
    in
    go 0

$ advance : Font -> @Int -> Real = \f g =>
    real_of_int (u16 f.bytes (f.hmtx + 4 * ARES.min g (f.metrics - 1)))

$ glyph_at : Font -> @Int -> @Int = \f g =>
    if f.long_loca => u32 f.bytes (f.loca + 4 * g) else 2 * u16 f.bytes (f.loca + 2 * g)

# The point flags, a repeat flag (8) followed by how many more times it holds.
# Returns them and where the coordinates begin.
$ point_flags : @Str -> @Int -> @Int -> @Vec @Int -> { @Vec @Int, @Int } = \b at n acc =>
    if @vec_len acc >= n =>
        { acc, at }
    else
        let fl = u8 b at in
        if bit fl 8 =>
            point_flags b (at + 2) n (append (@vec_fill (u8 b (at + 1) + 1) fl) acc)
        else
            point_flags b (at + 1) n (@vec_push acc fl)

# One axis of the coordinates, each a delta from the last: a byte whose sign
# is the `same` flag when the `short` flag is set, else a repeat of the last
# when `same` is set, else a signed word.
$ deltas : @Str -> @Int -> @Vec @Int -> @Int -> @Int
    -> { @Vec @Int, @Int } = \b at flags short same =>
    let n = @vec_len flags in
    let go =
        \i at cur acc =>
            if i == n =>
                { acc, at }
            else
                let fl = @vec_get flags i in
                if bit fl short =>
                    let v = cur + (if bit fl same => u8 b at else 0 - u8 b at) in
                    go (i + 1) (at + 1) v (@vec_push acc v)
                else if bit fl same =>
                    go (i + 1) at cur (@vec_push acc cur)
                else
                    let v = cur + i16 b at in go (i + 1) (at + 2) v (@vec_push acc v)
    in
    go 0 at 0 (@vec_new {})

# A contour of on-curve (`on`) and off-curve points as a polygon: each
# quadratic arc in eight chords, with the on-curve point implied between two
# off-curve ones.
$ OutlinePoint : @Type = { Real, Real, @Bool }

$ flatten : @Vec OutlinePoint -> @Vec Point = \pts =>
    let n = @vec_len pts in
    let first_on = find_index (\p => p.2) pts |> \ | Opt.Some.{ i } => i | _ => 0 in
    let pt = \i => @vec_get pts ((first_on + i) % n) in
    let half = \a b => { (a.0 + b.0) / 2.0, (a.1 + b.1) / 2.0 } in
    let quad =
        \acc a c z =>
            fold (\out i =>
                let t = real_of_int i / 8.0 in
                let u = 1.0 - t in
                @vec_push
                    out {
                        u * u * a.0 + 2.0 * u * t * c.0 + t * t * z.0,
                        u * u * a.1 + 2.0 * u * t * c.1 + t * t * z.1
                    }) acc (fmap (\i => i + 1) (upto 8))
    in
    let start = { (pt 0).0, (pt 0).1 } in
    let go =
        \i last ctrl acc =>
            let close = i == n + 1 in
            if close =>
                acc
            else
                let p = pt i in
                let here = { p.0, p.1 } in
                if p.2 || i == n =>
                    let q = if i == n => start else here in
                    ctrl |> \
                        | Opt.Some.{ c } => go (i + 1) q Opt.None (quad acc last c q)
                        | Opt.None       => go (i + 1) q Opt.None (@vec_push acc q)
                else
                    ctrl |> \
                        | Opt.Some.{ c } =>
                            let m = half c here in
                            go (i + 1) m Opt.Some.{ here } (quad acc last c m)
                        | Opt.None       => go (i + 1) last Opt.Some.{ here } acc
    in
    go 1 start Opt.None [start]

# Glyph `g`'s contours in font units, y up. Composite glyphs are left out:
# Cinzel draws its letters as simple ones.
$ outline : Font -> @Int -> @Vec (@Vec Point) = \f g =>
    let b = f.bytes in
    let at = f.glyf + glyph_at f g in
    let contours = if glyph_at f (g + 1) == glyph_at f g => 0 else i16 b at in
    if contours <= 0 =>
        []
    else
        let ends = fmap (\k => u16 b (at + 10 + 2 * k)) (upto contours) in
        let n = @vec_get ends (contours - 1) + 1 in
        let code = at + 12 + 2 * contours in
        let fl = point_flags b (code + u16 b (code - 2)) n (@vec_new {}) in
        let xs = deltas b fl.1 fl.0 2 16 in
        let ys = deltas b xs.1 fl.0 4 32 in
        let point =
            \i =>
                {
                    real_of_int (@vec_get xs.0 i),
                    real_of_int (@vec_get ys.0 i),
                    bit (@vec_get fl.0 i) 1
                }
        in
        fmap (\k =>
            let from = if k == 0 => 0 else @vec_get ends (k - 1) + 1 in
            flatten (fmap (\i => point (from + i)) (upto (@vec_get ends k - from + 1))))
            (upto contours)

# The width `s` takes set at cap height `cap`, `track` of the cap height added
# between letters.
$ text_width : Font -> Real -> Real -> @Str -> Real = \f cap track s =>
    let scale = cap / f.cap in
    let n = @array_len s in
    fold (\w i => w + scale * advance f (glyph_index f (@array_get s i))) 0.0 (upto n) + track * cap
        * real_of_int (n - 1)

# `s` as figures, its baseline starting at (x, y).
$ text : Font -> Real -> Real -> Real -> Real -> @Str -> @Vec Figure = \f cap track x y s =>
    let scale = cap / f.cap in
    let go =
        \i pen acc =>
            if i == @array_len s =>
                acc
            else
                let g = glyph_index f (@array_get s i) in
                let figs = fmap (\c => poly (fmap (\p => { pen + scale * p.0, y - scale * p.1 }) c))
                    (outline f g) in
                go (i + 1) (pen + scale * advance f g + track * cap) (append figs acc)
    in
    go 0 x (@vec_new {})

$ Fonts : @Type = @struct
    bold: Font,
    regular: Font,

$ cinzel : {} -> <@IO> Opt Fonts =
    let dir = env "ARES_FONT_CINZEL" in
    if dir == "" =>
        Opt.None
    else
        load_font "?(dir)/Cinzel-Bold.ttf" |> \
            | Opt.None          => Opt.None
            | Opt.Some.{ bold } => load_font "?(dir)/Cinzel-Regular.ttf" |> \
                | Opt.None             => Opt.None
                | Opt.Some.{ regular } => Opt.Some.{ Fonts.{ bold, regular } }

# ---- lockups ----

$ tagline : @Str = "Effects in a functional style"

# Letter spacing, in cap heights.
$ word_track : Real = 0.114
$ tag_track : Real = 0.071

# The hoplite `size` high at (x, y), ARES to his right and the tagline under
# it, as wide as the word. Returns the layers and the right edge of the word.
$ lockup_at : Fonts -> @Bool -> Rgb -> Rgb -> Real -> Real -> Real
    -> { @Vec Layer, Real } = \fs dark color tag_color x y size =>
    let cap = 0.363 * size in
    let tx = x + size * 1.085 in
    let ww = text_width fs.bold cap word_track "ARES" in
    let tcap0 = 0.081 * size in
    let tw0 = text_width fs.regular tcap0 tag_track tagline in
    let tcap = if tw0 > ww => tcap0 * ww / tw0 else tcap0 in
    let tw = text_width fs.regular tcap tag_track tagline in
    {
        concat [
            fmap (place_layer x y size) (hoplite dark),
            [
                Layer.{
                    "word",
                    Opt.Some.{ color },
                    text fs.bold cap word_track tx (y + size * 0.602) "ARES"
                },
                Layer.{
                    "tagline",
                    Opt.Some.{ tag_color },
                    text fs.regular tcap tag_track (tx + (ww - tw) / 2.0) (y + size * 0.787) tagline
                },
            ],
        ],
        tx + ww,
    }

$ lockup : Fonts -> @Bool -> Design = \fs dark =>
    let color = if dark => gold else ink in
    let l = lockup_at fs dark color color 0.0 0.0 1.0 in
    Design.{
        .width = l.1 + 0.04,
        .height = 1.0,
        .background = Opt.None,
        .layers = l.0,
        .style = ""
    }

# The repository's preview card, 2:1: the gold hoplite at the left on the
# dark ground, ARES to his right over a gold rule, the tagline under it.
$ social : Fonts -> Design = \fs =>
    let size = 0.8125 in
    let fig = fmap (place_layer 0.1094 0.0938 size) (hoplite @true) in
    let cap = 0.2078 in
    let tx = 1.0156 in
    let ww = text_width fs.bold cap word_track "ARES" in
    let tcap0 = 0.0481 in
    let tw0 = text_width fs.regular tcap0 tag_track tagline in
    let tcap = if tw0 > ww => tcap0 * ww / tw0 else tcap0 in
    let tw = text_width fs.regular tcap tag_track tagline in
    let dim = Rgb.{ .r = 201, .g = 152, .b = 58 } in
    Design.{
        .width = 2.0,
        .height = 1.0,
        .background = Opt.Some.{ night },
        .layers = concat [
            fig,
            [
                Layer.{ "word", Opt.Some.{ gold }, text fs.bold cap word_track tx 0.5469 "ARES" },
                Layer.{
                    "rule",
                    Opt.Some.{ gold },
                    [box (tx + 0.006) 0.6031 (tx + ww - 0.006) 0.6078]
                },
                Layer.{
                    "tagline",
                    Opt.Some.{ dim },
                    text fs.regular tcap tag_track (tx + (ww - tw) / 2.0) 0.6969 tagline
                },
            ],
        ],
        .style = "",
    }

# ---- the flying spear ----

# A dory, 40 units long and pointing right along the line y = cy: a crimson
# shaft, then gold fittings (the butt spike at the back, two rings binding the
# socket, the leaf-shaped head) and a crimson midrib down the head. The head is
# about three shafts wide.
$ dory : Real -> @Vec Layer = \cy =>
    let s = 0.25 in
    let spike = poly [
        { 0.0, cy },
        { 1.6, cy - 0.3 },
        { 2.6, cy - 0.3 },
        { 2.6, cy + 0.3 },
        { 1.6, cy + 0.3 }
    ] in
    let head = poly [
        { 30.6, cy - 0.3 },
        { 33.4, cy - 0.82 },
        { 35.6, cy - 0.7 },
        { 40.0, cy },
        { 35.6, cy + 0.7 },
        { 33.4, cy + 0.82 },
        { 30.6, cy + 0.3 },
    ] in
    let rib = poly [{ 31.2, cy - 0.09 }, { 38.6, cy }, { 31.2, cy + 0.09 }] in
    [
        Layer.{ "shaft", Opt.Some.{ crimson }, [box 2.4 (cy - s) 30.9 (cy + s)] },
        Layer.{
            "fittings",
            Opt.Some.{ gold },
            [
                spike,
                box 29.4 (cy - 0.36) 29.8 (cy + 0.36),
                box 30.2 (cy - 0.36) 30.6 (cy + 0.36),
                head
            ],
        },
        Layer.{ "midrib", Opt.Some.{ crimson }, [rib] },
    ]

$ spear_sprite : Design =
    Design.{ .width = 40.0, .height = 2.0, .background = Opt.None, .layers = dory 1.0, .style = "" }

# A spear carrying a gold shield seen edge-on, a third of the way along the
# shaft, the shield cut back around it.
$ spear_shield_sprite : Design =
    let cy = 4.0 in
    let edge = [Figure.Oval.{ 13.0, cy, 1.5, 3.7 }, Figure.Oval.{ 13.0, cy, 0.98, 3.18 }] in
    Design.{
        .width = 40.0,
        .height = 8.0,
        .background = Opt.None,
        .layers = append
            (dory cy) [
                Layer.{ "shield", Opt.Some.{ gold }, edge },
                Layer.{ "channel", Opt.None, [box 0.0 (cy - 0.45) 40.0 (cy + 0.45)] },
            ],
        .style = "",
    }

# ---- vector: SVG ----

$ hex2 : @Int -> @Str = \n =>
    let digits = "0123456789abcdef" in
    @array_push (@array_push "" (@array_get digits (n / 16))) (@array_get digits (n % 16))

$ css : Rgb -> @Str = \c => "#?(hex2 c.r)?(hex2 c.g)?(hex2 c.b)"

# Coordinates rounded to 1/10000 of the side, which is finer than any screen.
$ num : Real -> @Str = \x =>
    let n = int_of_real (ARES.round (x * 10000.0)) in
    let m = if n < 0 => 0 - n else n in
    let frac = m % 10000 in
    let pad = if frac < 10 => "000" else if frac < 100 => "00" else if frac < 1000 => "0" else "" in
    "?(if n < 0 => "-" else "")?(m / 10000).?(pad)?(frac)"

# Each figure as a closed subpath. An oval is two half-oval arcs, since one
# arc cannot start and end at the same point.
$ subpath : Figure -> @Str = \f =>
    f |> \
        | Figure.Oval.{ x, y, rx, ry } =>
            let arc = "a?(num rx) ?(num ry) 0 1 0" in
            "M?(num (x - rx)) ?(num y)?(arc) ?(num (2.0 * rx)) 0?(arc) -?(num (2.0 * rx)) 0Z"
        | Figure.Poly.{ ps, _, _ } =>
            let corner = \s p => s ++ (if s == "" => "M" else "L") ++ "?(num p.0) ?(num p.1)" in
            fold corner "" ps ++ "Z"
        | Figure.Curve.{ ns, _, _, _ } =>
            let v = \i => num (@vec_get ns i) in
            let seg =
                \k =>
                    let o = 6 * k + 2 in
                    "C?(v o) ?(v (o + 1)) ?(v (o + 2)) ?(v (o + 3)) ?(v (o + 4)) ?(v (o + 5))"
            in
            "M?(v 0) ?(v 1)" ++ ARES.join "" (fmap seg (upto ((@vec_len ns - 2) / 6))) ++ "Z"

# One path per layer, in order, so later layers paint over earlier ones. An
# eraser wraps everything drawn so far in a mask that is black on its figures,
# so the accumulator carries a count to keep mask ids distinct.
$ svg_layer : Design -> { @Str, @Int } -> Layer -> { @Str, @Int } = \d acc l =>
    let path = ARES.join "" (fmap subpath l.figures) in
    l.color |> \
        | Opt.Some.{ c } => {
            acc.0
                ++ "<path class=\"?(l.name)\" fill-rule=\"evenodd\" fill=\"?(css c)\" d=\"?(path)\"/>\n",
            acc.1
        }
        | Opt.None =>
            let id = "erase?(acc.1)" in
            {
                "<mask id=\"?(id)\"><rect width=\"?(num d.width)\" height=\"?(num d.height)\" fill=\"#fff\"/>"
                    ++ "<path fill-rule=\"evenodd\" d=\"?(path)\"/></mask>\n"
                    ++ "<g mask=\"url(#?(id))\">\n"
                    ++ acc.0
                    ++ "</g>\n",
                acc.1 + 1,
            }

$ svg : Design -> @Str = \d =>
    let ground =
        d.background |> \
            | Opt.Some.{ c } =>
                "<rect width=\"?(num d.width)\" height=\"?(num d.height)\" fill=\"?(css c)\"/>\n"
            | Opt.None => ""
    in
    let style = if d.style == "" => "" else "<style>?(d.style)</style>\n" in
    "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 ?(num d.width) ?(num d.height)\">\n"
        ++ style
        ++ ground
        ++ (fold (svg_layer d) { "", 0 } d.layers).0
        ++ "</svg>\n"

# ---- raster: the even-odd rule, a row at a time ----

# A ray from a point going right crosses a figure's outline an odd number of
# times exactly when the point is inside, whatever the figure's shape. So each
# row of the image first finds where its center line crosses every outline;
# a pixel is then covered by a layer when an odd number of the layer's
# crossings lie to its right.
$ edge_crossings : Real -> @Vec Point -> @Vec Real = \y ps =>
    let n = @vec_len ps in
    fold (\acc i =>
        let a = @vec_get ps i in
        let b = @vec_get ps (if i == 0 => n - 1 else i - 1) in
        if (a.1 > y) == (b.1 > y) =>
            acc
        else
            @vec_push acc (a.0 + (b.0 - a.0) * (y - a.1) / (b.1 - a.1))) (@vec_new {}) (upto n)

$ crossings : Real -> Figure -> @Vec Real = \y f =>
    f |> \
        | Figure.Oval.{ x, cy, rx, ry } =>
            let v = (y - cy) / ry in
            if v * v >= 1.0 => [] else let h = rx * C.sqrt (1.0 - v * v) in [x - h, x + h]
        | Figure.Poly.{ ps, lo, hi }     => if y > lo.1 && y < hi.1 => edge_crossings y ps else []
        | Figure.Curve.{ _, ps, lo, hi } => if y > lo.1 && y < hi.1 => edge_crossings y ps else []

# A layer cut down to one row: its color and its outlines' crossings.
$ Row : @Type = { Opt Rgb, @Vec Real }

$ covers : Real -> @Vec Real -> @Bool = \x xs =>
    (fold (\n c => if c > x => n + 1 else n) 0 xs) % 2 == 1

# An eraser clears down to the background, not through it.
$ color_at : Opt Rgb -> @Vec Row -> Real -> Opt Rgb = \ground rows x =>
    fold (\c r => if covers x r.1 => r.0 |> \ | Opt.Some.{ _ } => r.0 | Opt.None => ground else c)
        ground rows

$ push_rgba : @Str -> Opt Rgb -> @Str = \acc o =>
    o |> \
        | Opt.Some.{ c } =>
            @array_push (@array_push (@array_push (@array_push acc c.r) c.g) c.b) 255
        | Opt.None       => @array_push (@array_push (@array_push (@array_push acc 0) 0) 0) 0

# One row of the image as RGBA bytes. Appending to a string copies it, so the
# row is built in short chunks that are joined once.
$ pam_row : Design -> @Int -> @Int -> @Str = \d cols row =>
    let pixel = d.width / real_of_int cols in
    let y = (real_of_int row + 0.5) * pixel in
    let rows = filter (\r => @vec_len r.1 > 0)
        (fmap (\l => { l.color, flat_map (crossings y) l.figures }) d.layers) in
    let go =
        \col chunk chunks =>
            if col == cols =>
                @vec_push chunks chunk
            else
                let more = push_rgba chunk
                    (color_at d.background rows ((real_of_int col + 0.5) * pixel)) in
                if col % 32 == 31 =>
                    go (col + 1) "" (@vec_push chunks more)
                else
                    go (col + 1) more chunks
    in
    ARES.join "" (go 0 "" (@vec_new {}))

# A PAM (P7): a tiny text header, then RGBA bytes row by row. ffmpeg reads it
# directly, so no image library is needed. Each pixel is one hard sample; the
# anti-aliasing comes from ffmpeg averaging many of them when it scales down.
$ pam : Design -> @Int -> @Str = \d cols =>
    let rows = int_of_real (real_of_int cols * d.height / d.width) in
    let go =
        \row acc => if row == rows => acc else go (row + 1) (@vec_push acc (pam_row d cols row))
    in
    let header =
        "P7\nWIDTH ?(cols)\nHEIGHT ?(rows)\nDEPTH 4\nMAXVAL 255\nTUPLTYPE RGB_ALPHA\nENDHDR\n"
    in
    header ++ ARES.join "" (go 0 (@vec_new {}))

# ---- output ----

# Scaling averages neighboring pixels, so it runs on premultiplied color: a
# clear pixel then adds nothing, instead of its hidden color bleeding into the
# edge next to it.
$ ffmpeg : @Str -> @Int -> @Str -> <@IO> @Int = \src width dst =>
    let chain =
        "format=rgba,premultiply=inplace=1,scale=?(width):-1:flags=area,unpremultiply=inplace=1"
    in
    C.system "ffmpeg -loglevel error -y -i ?(src) -vf ?(chain) ?(dst)"

# How many of the steps `step` takes on the items from `i` on fail.
$ failures : @ctx { t: @Type } -> (t -> <@IO> @Int) -> @Vec t -> @Int
    -> <@IO> @Int = \step items i =>
    if i == @vec_len items => 0 else step (@vec_get items i) + failures step items (i + 1)

# `d` as SVG at `out` (none when empty) and as each PNG { path, width }, all
# scaled down from one master raster three times the widest, so every pixel
# averages at least 3x3 samples. Returns how many files failed.
$ render : Design -> @Str -> @Vec { @Str, @Int } -> <@IO> @Int = \d out pngs =>
    let svg_failed =
        if out == "" =>
            (if @vec_len pngs == 0 => print (svg d) else {}); 0
        else if write_file out (svg d) =>
            println "wrote ?(out)"; 0
        else
            eprintln "cannot write ?(out)"; 1
    in
    if @vec_len pngs == 0 =>
        svg_failed
    else
        let master = "?((@vec_get pngs 0).0).master.pam" in
        write_file master (pam d (3 * fold (\w p => ARES.max w p.1) 0 pngs));
        let failed =
            failures (\p =>
                if ffmpeg master p.1 p.0 == 0 =>
                    println "wrote ?(p.0)"; 0
                else
                    eprintln "ffmpeg failed on ?(p.0)"; 1) pngs 0
        in
        remove_file master; svg_failed + failed

$ design_named : Opt Fonts -> @Str -> Opt Design = \fs name =>
    let lettered =
        \build => fs |> \ | Opt.Some.{ f } => Opt.Some.{ build f } | Opt.None => Opt.None
    in
    name |> \
        | "logo"         => Opt.Some.{ square Opt.None (hoplite @false) }
        | "logo-dark"    => Opt.Some.{ square Opt.None (hoplite @true) }
        | "icon"         => Opt.Some.{ favicon }
        | "icon-light"   => Opt.Some.{ sprite @false soldier_16 }
        | "icon-dark"    => Opt.Some.{ sprite @true soldier_16 }
        | "icon32-light" => Opt.Some.{ sprite @false soldier_32 }
        | "icon32-dark"  => Opt.Some.{ sprite @true soldier_32 }
        | "badge"        => Opt.Some.{ badge }
        | "lockup-light" => lettered (\f => lockup f @false)
        | "lockup-dark"  => lettered (\f => lockup f @true)
        | "social"       => lettered social
        | "spear"        => Opt.Some.{ spear_sprite }
        | "spear-shield" => Opt.Some.{ spear_shield_sprite }
        | _              => Opt.None

# What a run with no arguments writes: { design, svg or "", pngs }.
$ assets : @Vec { @Str, @Str, @Vec { @Str, @Int } } = [
    { "logo", "documentation/assets/logo.svg", [] },
    { "logo-dark", "documentation/assets/logo-dark.svg", [] },
    { "icon", "documentation/assets/icon.svg", [] },
    { "lockup-light", "documentation/assets/lockup-light.svg", [] },
    { "lockup-dark", "documentation/assets/lockup-dark.svg", [] },
    { "social", "tools/assets/social.svg", [{ "documentation/assets/social.png", 1280 }] },
    { "icon-light", "tools/editors/vscode/icons/ares-light.svg", [] },
    { "icon-dark", "tools/editors/vscode/icons/ares-dark.svg", [] },
    {
        "badge",
        "tools/assets/badge.svg",
        [
            { "tools/assets/badge.png", 512 },
            { "tools/editors/vscode/icons/ares.png", 128 },
        ]
    },
]

$ usage : @Str =
    "usage: LOGO [logo|logo-dark|icon|icon-light|icon-dark|icon32-light|icon32-dark|badge|"
        ++ "lockup-light|lockup-dark|social|spear|spear-shield [out.svg [out.png width]...]]"

$ font_note : @Str =
    "the lockups and `social` need ARES_FONT_CINZEL, the directory of Cinzel's .ttf files"

$ make : Opt Fonts -> @Str -> @Str -> @Vec { @Str, @Int } -> <@IO> @Int = \fs name out pngs =>
    design_named fs name |> \
        | Opt.Some.{ d } => render d out pngs
        | Opt.None       => (if is_none fs => eprintln font_note else eprintln usage); 1

$ @main : @Vec @Str -> <@IO> @Int = \args =>
    let n = @vec_len args in
    let fs = cinzel {} in
    if n == 1 =>
        let failed = failures (\a => make fs a.0 a.1 a.2) assets 0 in if failed == 0 => 0 else 1
    else if n > 3 && n % 2 == 0 =>
        eprintln usage; 2
    else
        let out = if n > 2 => @vec_get args 2 else "" in
        let pngs = fmap (\i =>
            {
                @vec_get args (3 + 2 * i),
                from_str (@vec_get args (4 + 2 * i)) |> \ | Opt.Some.{ w } => w | _ => 0
            }) (upto ((n - 3) / 2)) in
        if make fs (@vec_get args 1) out pngs == 0 => 0 else 1
