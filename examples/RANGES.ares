$ @mod RANGES
$ @import ARESxALGO
$ @import ARESxVEC
$ @import ARESxLIST
$ @import ARESxLA

# \file ranges.ares
# \info Inclusive range patterns in match arms: `lo ... hi` matches when
#       `lo <= x <= hi`. Both bounds are numeric literals and both ends are
#       inclusive (Jai-style: there is only the inclusive form). A range is
#       refutable and binds nothing, so a match over ranges needs a catch-all arm. The
#       scrutinee variable stays in scope in the arm if you need the value.
#       The EXPRESSION form `[lo ... hi]` (below) is the same `...`, materialized.

$ grade : @Int -> @Str = \n =>
    n |> \
        | 90 ... 100 => "A"
        | 80 ... 89  => "B"
        | 70 ... 79  => "C"
        | 60 ... 69  => "D"
        | _          => "F"

# An OPEN range pattern `lo ...` omits the upper bound: it matches when `lo <= x`.
$ sign : @Int -> @Str = \n => n |> \ | 0 ... => "nonneg" | _ => "neg"
$ ck_open_pat : @Int = if sign 3 == "nonneg" => 0 else 1024
$ ck_open_neg : @Int = if sign (0 - 3) == "neg" => 0 else 2048

# Inclusive at both ends: 60 is a D, 100 is an A.
$ ck_a : @Int = if grade 95 == "A" => 0 else 1
$ ck_a2 : @Int = if grade 100 == "A" => 0 else 2
$ ck_c : @Int = if grade 70 == "C" => 0 else 4
$ ck_d : @Int = if grade 60 == "D" => 0 else 8
$ ck_f : @Int = if grade 42 == "F" => 0 else 16

# Ranges work on Real too; both bounds must share the scrutinee's type.
$ band : Real -> @Int = \x =>
    x |> \
        | 0.0 ... 0.5 => 1
        | 0.5 ... 1.0 => 2
        | _           => 0
$ ck_r : @Int = if band 0.25 == 1 => 0 else 32

# EXPRESSION form: `[lo ... hi]` is a TYPE-DIRECTED inclusive-range literal (the
# same `...`, materialized). By default it is a `@Vec @Int` (a runtime-length
# sequence). Empty when lo > hi.
$ ns : @Vec @Int = [1 ... 4] # [1, 2, 3, 4]
$ ck_build : @Int = if sum ns == 10 => 0 else 64
$ ck_len : @Int = if len ns == 4 => 0 else 128
$ ck_empty : @Int = if len [5 ... 2] == 0 => 0 else 256

# Against a sized tensor `@Tensor n T` it builds the tensor instead: the LITERAL bounds fix
# `n = hi - lo + 1` at compile time. A non-literal bound to a sized tensor is a
# compile-time error (its length would not be statically known).
$ tv : @Tensor 4 @Int = [1 ... 4] # the tensor [1, 2, 3, 4]
$ ck_tens : @Int = if tv.[0] + tv.[3] == 5 => 0 else 512

# An OPEN range `[lo ...]` has no upper bound, so it is infinite: a `List @Int`
# whose lazy tail is built a cell at a time as it is walked.
$ odds : List @Int = [3 ...]
$ ck_stream : @Int = if foldl (\a x => a + x) 0 (take 2 odds) == 7 => 0 else 4096

# A bare range builds a `List`, lazy in the tail, so a range you only walk part of
# costs only the part you walk: this one stops after five of 10^14 cells. Where a
# `@Vec` is expected (`ns` above) the range materializes every element up front.
$ Seen : @effect = saw : @Int -> {},
$ walked : @Int =
    do for [1 ... 100000000000000] (\i => if i > 5 => break {} else Seen.saw i)
    ctl k | Seen.saw n => n + k {} | r => 0
$ ck_lazy_range : @Int = if walked == 15 => 0 else 512

# A bare open range is a `List` too.
$ ck_lazy_open : @Int = if ([7 ...] |> \ | List.Cons.{ h, t } => h | _ => 0) == 7 => 0 else 1024

$ test : @Int =
    ck_a + ck_a2 + ck_c + ck_d + ck_f + ck_r + ck_build + ck_len + ck_empty + ck_tens + ck_open_pat
        + ck_open_neg + ck_stream + ck_lazy_range + ck_lazy_open

$ &assert (test == 0) "RANGES: a check failed"
