$ @mod STDLIB_LAZY_LIST

# \file STDLIB_LAZY_LIST.ares
# \info The standard library's LIST module over CORE's cons `List`. The
#       rebuilding functions are lazy in the tail, so a pipeline over an
#       unbounded list streams: only the cells a consumer looks at are built.

$ @import ARESxALGO
$ @import ARESxLIST
$ @import ARESxOPT

$ nums : List @Int = [1, 2, 3, 4, 5]
$ naturals : List @Int = [0 ...]

$ ck_length : @Int = if len nums == 5 => 0 else 1
$ ck_map : @Int = if foldl (\a x => a + x) 0 (fmap (\x => x * x) nums) == 55 => 0 else 1
$ ck_filter : @Int = if len (filter (\x => x % 2 == 0) nums) == 2 => 0 else 1
$ ck_rev : @Int = if foldl (\a x => a * 10 + x) 0 (reverse nums) == 54321 => 0 else 1
$ ck_append : @Int = if len (append nums nums) == 10 => 0 else 1
$ ck_nth : @Int = if unwrap_or 0 (nth 3 nums) == 4 => 0 else 1
$ ck_last : @Int = if unwrap_or 0 (last nums) == 5 => 0 else 1
$ ck_vec : @Int = if @vec_len (ARES.to_vec nums) == 5 => 0 else 1
$ ck_back : @Int = if len (ARES.from_vec [7, 8, 9]) == 3 => 0 else 1

# An unbounded source, transformed and cut: only ten cells are ever built.
$ ck_stream : @Int =
    let evens = filter (\x => x % 2 == 0) naturals in
    if foldl (\a x => a + x) 0 (take 10 (fmap (\x => x * 3) evens)) == 270 => 0 else 1

$ ck_find : @Int = if unwrap_or 0 (find (\x => x > 1000) naturals) == 1001 => 0 else 1

$ test : @Int =
    ck_length + ck_map + ck_filter + ck_rev + ck_append + ck_nth + ck_last + ck_vec + ck_back
        + ck_stream + ck_find

$ &assert (test == 0) "STDLIB_LAZY_LIST: a check failed"
