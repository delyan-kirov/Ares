$ @mod STDLIB_MAP

# \file STDLIB_MAP.ares
# \info The standard library's ordered map (an immutable AVL tree). The key
#       ordering is the `IOrd` interface, found by type, so `Map `K `V` works
#       for any ordered key with nothing to pass. Maps are values: `insert` /
#       `remove` return an updated copy and never disturb the original, and
#       `to_list` / `keys` come back in ascending key order.

$ @import ARESxALGO
$ @import ARESxMAP
$ @import ARESxOPT
$ @import ARESxVEC
$ @import ARESxSTR
$ @import ARESxMATH

$ ages : Map @Str @Int = insert "bob" 25 (insert "alice" 30 (insert "carol" 41 (new {})))

$ ck_size : @Int = if (len ages) == 3 => 0 else 1
$ ck_get : @Int = if (get_or "bob" 0 ages) == 25 => 0 else 1
$ ck_missing: @Int = if has "dave" ages => 1 else 0
$ ck_update : @Int = if (get_or "bob" 0 (insert "bob" 26 ages)) == 26 => 0 else 1
$ ck_upsize : @Int = if (len (insert "bob" 26 ages)) == 3 => 0 else 1
$ ck_remove : @Int = if (len (remove "alice" ages)) == 2 => 0 else 1
$ ck_gone : @Int = if has "alice" (remove "alice" ages) => 1 else 0
$ ck_shared : @Int =
    if (len ages) == 3 =>
        0
    else
        1 # original undisturbed
$ ck_values : @Int = if (sum (values ages)) == 96 => 0 else 1

# Iteration is ordered: keys come back sorted regardless of insert order.
$ ck_sorted : @Int = if (join "," (keys ages)) == "alice,bob,carol" => 0 else 1

# insert_with combines with the existing value; a fresh key just inserts.
$ hits : Map @Str @Int =
    insert_with "x" 10 (\old nw => old + nw) (insert_with "x" 1 (\old nw => old + nw) (new {}))
$ ck_insw : @Int = if (get_or "x" 0 hits) == 11 => 0 else 1

# update touches present keys only.
$ ck_upd : @Int = if (get_or "bob" 0 (update "bob" (\v => v + 1) ages)) == 26 => 0 else 1
$ ck_updno: @Int = if (len (update "zzz" (\v => v + 1) ages)) == 3 => 0 else 1

# fold visits in ascending key order.
$ ck_fold : @Int = if (fold (\acc k v => acc * 100 + v) 0 ages) == 302541 => 0 else 1

$ ck_mapv : @Int = if (sum (values (map_values (\v => v * 2) ages))) == 192 => 0 else 1
$ ck_filt : @Int = if (len (filter (\k v => v < 40) ages)) == 2 => 0 else 1

# merge is left-biased.
$ others : Map @Str @Int = insert "dave" 50 (insert "bob" 99 (new {}))
$ ck_merge : @Int =
    let u = merge others ages in if (len u) == 4 => (if (get_or "bob" 0 u) == 25 => 0 else 1) else 1

$ ck_min : @Int = min_entry ages |> \ | Opt.Some.{ p } => (if p.0 == "alice" => 0 else 1) | _ => 1
$ ck_max : @Int = max_entry ages |> \ | Opt.Some.{ p } => (if p.1 == 41 => 0 else 1) | _ => 1

$ ck_froml : @Int =
    let m = from_list [{ 2, "two" }, { 1, "one" }, { 2, "II" }] in
    if (len m) == 2 => (if (get_or 2 "" m) == "II" => 0 else 1) else 1

# Tuples order lexicographically through their components' `IOrd`: tuple keys.
$ grid : Map { @Int, @Str } @Int =
    from_list [{ { 1, "b" }, 12 }, { { 1, "a" }, 11 }, { { 2, "a" }, 21 }]
$ ck_pair : @Int = if (get_or { 1, "a" } 0 grid) == 11 => 0 else 1
$ ck_pair2 : @Int =
    min_entry grid |>
        \ | Opt.Some.{ p } => (if p.0.1 == "a" => (if p.1 == 11 => 0 else 1) else 1) | _ => 1

# Balance stress: 200 ascending inserts (the classic worst case for an
# unbalanced BST), everything retrievable, ordered iteration intact.
$ big : Map @Int @Int = foldl (\m k => insert k (k * k) m) (new {}) (range 0 199)
$ ck_bigsize : @Int = if (len big) == 200 => 0 else 1
$ ck_bigget : @Int = if (all (\k => (get_or k (0 - 1) big) == k * k) (range 0 199)) => 0 else 1
$ ck_bigmin : @Int = min_entry big |> \ | Opt.Some.{ p } => (if p.0 == 0 => 0 else 1) | _ => 1
$ ck_bigrm : @Int =
    let slim = foldl (\m k => remove k m) big (range 0 99) in
    if (len slim) == 100 =>
        (if has 99 slim => 1 else (if (get_or 150 0 slim) == 22500 => 0 else 1))
    else
        1

# Aggregate check for the combined test runner: 0 = all pass.
$ test : @Int =
    ck_size + ck_get + ck_missing + ck_update + ck_upsize + ck_remove + ck_gone + ck_shared
        + ck_values + ck_sorted + ck_insw + ck_upd + ck_updno + ck_fold + ck_mapv + ck_filt
        + ck_merge + ck_min + ck_max + ck_froml + ck_pair + ck_pair2 + ck_bigsize + ck_bigget
        + ck_bigmin + ck_bigrm

$ &assert (test == 0) "STDLIB_MAP: a check failed"
