$ @mod PROPOSITIONS

# \file PROPOSITIONS.ares
# \info Propositions `a ~ b` and their proofs (#539, #596, #608). A `let`
#       of a type, a size or a boolean stays transparent, so an annotation
#       may name it and a size may pass as a `(n: @Nat)` argument, and a
#       `@transp` motive may be a type-level function by name.
#       A proposition field of `@ctx` is proved at each use, by computing it
#       or from the hypotheses in scope (#540).

$ @import ARESxALGO
$ @import ARESxLA

$ Pos : (n: @Nat) -> @Type 0 = 0 < n
$ Lt : (a: @Nat) -> (b: @Nat) -> @Type 0 = a < b

# A motive by name, or applied to all its arguments but the last.
$ pos_along : (n: @Nat) -> (m: @Nat) -> n ~ m -> Pos n -> Pos m = \q p => @transp n Pos p m q
$ lt_along : (n: @Nat) -> (m: @Nat) -> n ~ m -> 2 < n -> Lt 2 m = \q p => @transp n (Lt 2) p m q

$ three : Pos 3 = pos_along 3 3 (@refl 3) (@refl true)

# A `let` of a type names it in the annotations of its body.
$ bump : @Int -> @Int = \y =>
    let t = @Int in
    let inc = \(x: t) => x + 1 in
    let z : t = inc y in
    z

$ twice : @Int -> @Int = \y =>
    let endo = @Int -> @Int in
    let f : endo = \x => x * 2 in
    f y

# A `let` of a size sizes a tensor, and one of a boolean is a proposition.
$ total : @Int =
    let n = 3 in
    let v : @Tensor n @Int = [1, 2, 3] in
    let small = n < 4 in
    let p : small = @refl true in
    v.[0] + v.[1] + v.[2]

# A `let` of a size is the size argument of a `(n: @Nat)` parameter.
$ width : (n: @Nat) -> @Nat = n
$ same : (n: @Nat) -> n ~ n = @refl n
$ doubled : @Nat =
    let n = 3 in
    let m = n + 1 in
    let p : 4 ~ 4 = same m in
    width (m * 2)

# A precondition in `@ctx`: a caller passes no proof.
$ past_two : @ctx { n: @Nat, a: @Type, ok: 2 < n } -> @Tensor n a -> @Nat = \_ => n - 3
$ below_four : @ctx { n: @Nat, ok: n < 4 } -> @Nat = 3 - n

# The facts of a branch prove it, as do the definition's own proof fields.
$ guarded : @ctx { n: @Nat } -> @Nat = if n < 4 => below_four @ctx { .n = n } else 0
$ negated : @ctx { n: @Nat } -> @Nat = if 4 <= n => 0 else below_four @ctx { .n = n }
$ passed : @ctx { m: @Nat, p: m < 4 } -> @Nat = below_four @ctx { .n = m }
$ arms : @ctx { n: @Nat } -> @Nat = n |> \ | 0 => below_four @ctx { .n = n } | 9 => 9 | _ => 1
$ both : @ctx { n m: @Nat } -> @Nat =
    if n < 4 && m < 4 => below_four @ctx { .n = n } + below_four @ctx { .n = m } else 0

$ preconditions : @Nat =
    let early = past_two [1, 2, 3, 4, 5] + guarded @ctx { .n = 1 } + negated @ctx { .n = 7 } in
    early + passed @ctx { .m = 3 } + arms @ctx { .n = 0 } + both @ctx { .n = 1, .m = 2 }

$ test : @Int =
    (if bump 4 == 5 => 0 else 1) + (if twice 4 == 8 => 0 else 2) + (if total == 6 => 0 else 4)
        + (if preconditions == 10 => 0 else 8) + (if doubled == 8 => 0 else 16)

$ !assert (test == 0) "PROPOSITIONS: a check failed"
