$ @mod STDLIB_RANDOM

# \file STDLIB_RANDOM.ares
# \info The standard library's pseudo-random generator (Lehmer / MINSTD). The
#       generator is a value threaded through `next`, so a fixed seed gives a
#       reproducible sequence -- which is exactly what a test wants.

$ @import ARESxALGO
$ @import ARESxRANDOM
$ @import ARESxVEC

# The MINSTD sequence from seed 1: 48271, then 48271^2 mod (2^31 - 1).
$ d1 : { @Int, Rng } = next (ARES.seed 1)
$ d2 : { @Int, Rng } = next d1.1

$ ck_first : @Int = if d1.0 == 48271 => 0 else 1
$ ck_second : @Int = if d2.0 == 182605794 => 0 else 1

# Seeds are normalised: negative and zero seeds still draw.
$ ck_neg : @Int = if (next (ARES.seed (0 - 7))).0 > 0 => 0 else 1
$ ck_zero : @Int = if (next (ARES.seed 0)).0 == 48271 => 0 else 1

# Bounded draws stay in range across a run of draws.
$ draws : @Vec @Int = draw_n (ARES.seed 42) 50
$ draw_n : Rng -> @Int -> @Vec @Int = \g n =>
    if n <= 0 => [] else let d = next_below 10 g in d.0 :: draw_n d.1 (n - 1)
$ ck_below : @Int = if all (\x => if x >= 0 => x < 10 else @false) draws => 0 else 1
$ ck_spread : @Int = if (maximum 0 draws) > (minimum 9 draws) => 0 else 1

$ ck_range : @Int =
    let d = next_range 5 6 (ARES.seed 7) in if d.0 >= 5 => (if d.0 <= 6 => 0 else 1) else 1

# Aggregate check for the combined test runner: 0 = all pass.
$ test : @Int = ck_first + ck_second + ck_neg + ck_zero + ck_below + ck_spread + ck_range

$ &assert (test == 0) "STDLIB_RANDOM: a check failed"
