$ @mod IMPORT_ALIAS

# \file IMPORT_ALIAS.ares
# \info Qualified-only imports: `V = VEC` reaches VEC's names only as `V.name`,
#       and `LIST = LIST` keeps LIST's own name as the qualifier. Each
#       `$ @import` names one module.

$ @import ARESxALGO
$ @import V = ARESxVEC
$ @import LIST = ARESxLIST
$ @import O = ARESxOPT

# VEC and LIST both export `length`, `map`, `foldl` and `find`. Neither import
# brings them in bare, so there is nothing to disambiguate.
$ v : @Vec @Int = V.push 3 (V.push 2 (V.push 1 (new {})))
$ l : List @Int = [4, 5, 6]

$ ck_len : @Int = if (len v) + (len l) == 6 => 0 else 1
$ ck_map : @Int = if (V.sum <| fmap (\x => x * 10) v) == 60 => 0 else 1
$ ck_fold : @Int = if (foldl (\a x => a + x) 0 <| fmap (\x => x + 1) l) == 18 => 0 else 1
$ ck_both : @Int = if (V.sum <| from_list <| reverse l) == 15 => 0 else 1

# Types and constructors go through the alias too.
$ found : O.Opt @Int = find (\x => x > 1) v
$ ck_type : @Int = found |> \ | O.Opt.Some.{ x } => (if x == 2 => 0 else 1) | _ => 1
$ ck_ctor : @Int = if unwrap_or 0 (O.Opt.Some.{ 7 }) == 7 => 0 else 1
$ ck_none : @Int = if O.is_none (find (\x => x > 9) l) => 0 else 1

# A local `length` is no clash: the imports brought none in bare.
$ length : @Int = 3
$ ck_local : @Int = if length == len v => 0 else 1

# Aggregate check for the combined test runner: 0 = all pass.
$ test : @Int = ck_len + ck_map + ck_fold + ck_both + ck_type + ck_ctor + ck_none + ck_local

$ !assert (test == 0) "IMPORT_ALIAS: a check failed"
