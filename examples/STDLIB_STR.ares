$ @mod STDLIB_STR

# \file STDLIB_STR.ares
# \info The standard library's STR module: searching, splitting, trimming,
#       ASCII case and number formatting/parsing over the byte-vector `@Str`.
#       `reverse`/`repeat`/`contains`/`find` also exist in VEC, so uses
#       here qualify where both modules are imported.

$ @import ARESxALGO
$ @import ARESxSTR
$ @import ARESxOPT
$ @import ARESxVEC

$ ck_len : @Int = if (len "hello") == 5 => 0 else 1
$ ck_at : @Int = if (at 1 "hello") == 101 => 0 else 1
$ ck_substr : @Int = if (substr 6 11 "hello world") == "world" => 0 else 1
$ ck_starts : @Int = if starts_with "he" "hello" => 0 else 1
$ ck_ends : @Int = if ends_with "llo" "hello" => 0 else 1
$ ck_find : @Int = if (unwrap_or 0 (ARES.index_of "wor" "hello world")) == 6 => 0 else 1
$ ck_miss : @Int = if is_none (ARES.index_of "xyz" "hello") => 0 else 1
$ ck_split : @Int = if (len (split "," "a,b,,c")) == 4 => 0 else 1
$ ck_join : @Int = if (join "," (split "," "a,b,,c")) == "a,b,,c" => 0 else 1
$ ck_lines : @Int = if (len (lines "one\ntwo\nthree\n")) == 3 => 0 else 1
$ ck_trim : @Int = if (trim " \t hi there \n") == "hi there" => 0 else 1
$ ck_upper : @Int = if (to_upper "Hello, World!") == "HELLO, WORLD!" => 0 else 1
$ ck_lower : @Int = if (to_lower "Hello!") == "hello!" => 0 else 1
$ ck_rev : @Int = if (reverse "abcdef") == "fedcba" => 0 else 1
$ ck_rep : @Int = if (ARES.repeat 3 "ab") == "ababab" => 0 else 1
$ ck_fmt : @Int = if (to_string (0 - 1042)) == "-1042" => 0 else 1
$ ck_fmt0 : @Int = if (to_string 0) == "0" => 0 else 1
$ ck_parse : @Int = if (unwrap_or 0 (from_str "-273")) + 273 == 0 => 0 else 1
$ ck_parse_bad : @Int = let r : Opt @Int = from_str "12x" in if is_none r => 0 else 1
$ ck_digit : @Int = if is_digit (at 1 "a1") => 0 else 1
$ ck_space : @Int = if is_space (at 0 "\t") => 0 else 1
$ ck_alnum : @Int = if is_alnum (at 0 "a1") => (if is_alnum (at 0 "!") => 1 else 0) else 1
$ ck_case : @Int = if is_upper (at 0 "Ab") => (if is_lower (at 1 "Ab") => 0 else 1) else 1

$ ck_cmp_lt : @Int = if (cmp_str "abc" "abd") < 0 => 0 else 1
$ ck_cmp_eq : @Int = if (cmp_str "same" "same") == 0 => 0 else 1
$ ck_cmp_pfx: @Int = if (cmp_str "ab" "abc") < 0 => 0 else 1
$ ck_byte : @Int = if (from_byte 65) == "A" => 0 else 1
$ ck_concat : @Int = if (concat ["ab", "", "cd"]) == "abcd" => 0 else 1
$ ck_padl : @Int = if (pad_left 3 "7") == "  7" => 0 else 1
$ ck_padr : @Int = if (pad_right 3 "7") == "7  " => 0 else 1
$ ck_padno : @Int = if (pad_left 2 "long") == "long" => 0 else 1
$ ck_repl : @Int = if (replace "," ";" "a,b,,c") == "a;b;;c" => 0 else 1
$ ck_replgrow : @Int = if (replace "a" "aaa" "aa") == "aaaaaa" => 0 else 1
$ ck_count : @Int = if (count "an" "banana") == 2 => 0 else 1
$ ck_count0 : @Int = if (count "" "banana") == 0 => 0 else 1

# Aggregate check for the combined test runner: 0 = all pass.
$ test : @Int =
    ck_len + ck_at + ck_substr + ck_starts + ck_ends + ck_find + ck_miss + ck_split + ck_join
        + ck_lines + ck_trim + ck_upper + ck_lower + ck_rev + ck_rep + ck_fmt + ck_fmt0 + ck_parse
        + ck_parse_bad + ck_digit + ck_space + ck_alnum + ck_case + ck_cmp_lt + ck_cmp_eq
        + ck_cmp_pfx + ck_byte + ck_concat + ck_padl + ck_padr + ck_padno + ck_repl + ck_replgrow
        + ck_count + ck_count0

$ &assert (test == 0) "STDLIB_STR: a check failed"
