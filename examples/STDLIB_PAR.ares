$ @mod STDLIB_PAR

# \file STDLIB_PAR.ares
# \info Pure parallelism with the standard library's `PAR`: `par` starts a pure
#       task and returns its `Future`, `get` joins it, and `par_map` /
#       `par_fold` split a vector over parallel tasks, `par_map` a tensor
#       along its leading axis. Natively the tasks run
#       on a pool of threads; the interpreter runs each one on the spot. A task
#       is pure, so both give the same answers.

$ @import ARESxALGO
$ @import ARESxPAR
$ @import ARESxVEC
$ @import ARESxLA

$ fib : @Int -> @Int = \n => if n < 2 => n else fib (n - 1) + fib (n - 2)

$ xs : @Vec @Int = fmap (\i => 6 + (i % 5)) (range 0 99)

# One task, joined.
$ ck_one : @Int = if ARES.wait (par (\u => fib 16)) == 987 => 0 else 1

# Two at once.
$ ck_both : @Int =
    let p = both (\u => fib 15) (\u => "fifteen") in if p.0 == 610 && p.1 == "fifteen" => 0 else 1

# A parallel map equals the sequential one, element for element.
$ ck_map : @Int =
    let par_v = par_map fib xs in
    let seq_v = fmap fib xs in
    if len par_v == len seq_v
        && fold (\a x => a + x) 0 par_v == fold (\a x => a + x) 0 seq_v
        && get_or 57 0 par_v == fib (6 + (57 % 5)) =>
        0
    else
        1

# Fewer chunks than elements, more chunks than elements, and an empty vector.
$ ck_chunks : @Int =
    let a = fold (\s x => s + x) 0 (map_chunks 3 fib xs) in
    let b = fold (\s x => s + x) 0 (map_chunks 1000 fib xs) in
    let c = len (map_chunks 4 fib (new {})) in
    if a == b && c == 0 => 0 else 1

# A parallel reduction with an associative combine.
$ ck_reduce : @Int =
    if par_fold (\a b => a + b) 0 fib xs == fold (\a x => a + fib x) 0 xs => 0 else 1

# Tasks that spawn tasks.
$ ck_nested : @Int =
    let outer = par (\u => ARES.wait (par (\w => fib 12)) + ARES.wait (par (\w => fib 11))) in
    if ARES.wait outer == fib 13 => 0 else 1

# Over a tensor, the leading axis is split into O(1) slices, one task each:
# rows of a matrix, elements of a vector. Equal to the sequential `map`.
$ tv : @Tensor 12 @Int = [3, 9, 4, 12, 7, 5, 10, 8, 6, 11, 2, 13]
$ tm : @Tensor 3 (@Tensor 2 @Int) = [[1, 2], [3, 4], [5, 6]]

$ same : @Tensor n @Int -> @Tensor n @Int -> @Int -> @Int = \x y i =>
    if i == len x => 0 else if x.[i] == y.[i] => same x y (i + 1) else 1

$ ck_tensor : @Int =
    let seq_v = fmap fib tv in
    let row_sum = \r => r.[0] + r.[1] in
    let m = par_map row_sum tm in
    same (par_map fib tv) seq_v 0 + same (par_map_chunks 5 fib tv) seq_v 0 + same
        (par_map_chunks 100 fib tv) seq_v 0 + same m (fmap row_sum tm) 0
        + (if m.[2] == 11 && seq_v.[3] == 144 => 0 else 1)

# A task that performs an effect takes its handler along (`par_with`): the
# handler runs on the task's thread, so the effect never crosses threads.
$ Emit : @effect = emit : @Int -> {},

$ total : ({} -> <Emit> {}) -> @Int = \body =>
    let run =
        do body {}
        ctl k | Emit.emit n => \acc => k {} (acc + n) | u => \acc => acc
    in
    run 0

$ emit_fibs : @Int -> <Emit> {} = \n => if n < 0 => {} else (Emit.emit (fib n); emit_fibs (n - 1))

$ ck_with : @Int =
    let a = par_with total (\u => emit_fibs 10) in
    let b = par_with total (\u => emit_fibs 12) in
    if ARES.wait a == 143 && ARES.wait b == 376 => 0 else 1

# Aggregate check for the combined test runner: 0 = all pass.
$ test : @Int = ck_one + ck_both + ck_map + ck_chunks + ck_reduce + ck_nested + ck_tensor + ck_with

$ &assert (test == 0) "STDLIB_PAR: a check failed"
