$ @mod ARES

# \file ARESxRESULT.ares
# \info Fallible computation, in two interchangeable shapes (the Koka
#       exn/error pattern):
#         - `Result `T `E` (declared in CORE) is the VALUE shape: an `Ok` carrying the answer or
#           an `Err` carrying what went wrong.
#         - `Fail` is the EFFECT shape: `Fail.fail msg` aborts the current
#           computation, the effect row (`-> <Fail> T`) propagates the
#           possibility automatically -- no `?` operator needed -- and
#           `try` / `try_or` are the handlers that turn a failing computation
#           back into a value.
#       `untry` and `expect` bridge the two directions, so code can move
#       freely between "return a Result" and "perform Fail".

$ @import ARESxALGO
$ @import ARESxOPT

# ---- the value shape ----

$ is_ok : @ctx { t: @Type, e: @Type } -> Result t e -> Bool = \r =>
    r |> \ | Result.Ok.{ _ } => true | _ => false

$ is_err : @ctx { t: @Type, e: @Type } -> Result t e -> Bool = \r =>
    r |> \ | Result.Ok.{ _ } => false | _ => true

# `unwrap_or r d`: the answer, or `d` when the computation failed.
$ impl_IUnwrapOr_for_Result : @ctx { t: @Type, e: @Type } -> IUnwrapOr (Result t e) t =
    .{ .unwrap_or = \r d => r |> \ | Result.Ok.{ x } => x | _ => d }

# The arms below are exhaustive; the required `else` recurses, which is
# unreachable (a Result is always Ok or Err) but well-typed.
$ map_ok : @ctx { a: @Type, b: @Type, e: @Type } -> (a -> b) -> Result a e -> Result b e = \f r =>
    r |> \ | Result.Ok.{ x } => Result.Ok.{ f x } | Result.Err.{ e } => Result.Err.{ e }

$ map_err : @ctx { e: @Type, f: @Type, t: @Type } -> (e -> f) -> Result t e -> Result t f = \f r =>
    r |> \ | Result.Ok.{ x } => Result.Ok.{ x } | Result.Err.{ e } => Result.Err.{ f e }

# Chain a fallible step onto an earlier result (monadic bind).
$ and_then : @ctx { a: @Type, b: @Type, e: @Type } -> (a -> Result b e) -> Result a e
    -> Result b e = \f r =>
    r |> \ | Result.Ok.{ x } => f x | Result.Err.{ e } => Result.Err.{ e }

$ ok_opt : @ctx { t: @Type, e: @Type } -> Result t e -> Opt t = \r =>
    r |> \ | Result.Ok.{ x } => Opt.Some.{ x } | _ => Opt.None

# ---- the effect shape ----

$ Fail : @Effect =
    fail : @ctx { a: @Type } -> @Str -> a, # never resumes -> polymorphic result

# Run a computation that may Fail, reifying the outcome as a Result.
$ try : @ctx { t: @Type } -> ({} -> <Fail> t) -> Result t @Str = \action =>
    do Result.Ok.{ action {} }
    is k | Fail.fail msg => Result.Err.{ msg }

# Run a computation that may Fail; a failure just yields the default.
$ try_or : @ctx { t: @Type } -> ({} -> <Fail> t) -> t -> t = \action d =>
    do action {}
    is k | Fail.fail _ => d

# ---- bridges ----

# Re-raise a Result inside a Fail computation (Koka's untry): Ok passes
# through, Err becomes a failure.
$ untry : @ctx { t: @Type } -> Result t @Str -> <Fail> t = \r =>
    r |> \ | Result.Ok.{ x } => x | Result.Err.{ m } => Fail.fail m

# The Opt bridge: absence becomes a failure carrying `msg`.
$ expect : @ctx { t: @Type } -> Opt t -> @Str -> <Fail> t = \o msg =>
    o |> \ | Opt.Some.{ x } => x | _ => Fail.fail msg
