$ @mod ARES

# \file ARESxMATH.ares
# \info Integer helpers, Real helpers, and the libm functions (wrapped from
#       the auto-injected `C` namespace). Predicates return @Bool.
#       `min`/`max`/`abs`/`clamp` are each ONE generic definition over CORE's
#       comparison and arithmetic interfaces, so they work for any type that has
#       them, not just @Int and Real. `pow` is the named spelling of CORE's `^`.

# One definition each, over any ordered type.
$ @import ARESxALGO

$ min : @use { d: IOrd t } -> t -> t -> t = \a b => if d.lt b a => b else a
$ max : @use { d: IOrd t } -> t -> t -> t = \a b => if d.lt a b => b else a

# `x` forced into [lo, hi].
$ clamp : @use { d: IOrd t } -> t -> t -> t -> t = \lo hi x => max lo (min hi x)

# The distance from zero, for any type that is ordered and can subtract.
$ abs : @use { o: IOrd t, s: ISub t, z: IZero t } -> t -> t = \x =>
    if o.lt x z.zero => s.sub z.zero x else x

# Three-way comparison: negative / 0 / positive.
$ cmp_int : @Int -> @Int -> @Int = \a b => if a < b => 0 - 1 else if a > b => 1 else 0

$ sign : @Int -> @Int = \n => if n < 0 => 0 - 1 else if n > 0 => 1 else 0

$ even : @Int -> @Bool = \n => (abs n) % 2 == 0
$ odd : @Int -> @Bool = \n => !(even n)

$ gcd : @Int -> @Int -> @Int = \a b => if b == 0 => abs a else gcd b (a % b)

# `pow` is the named spelling of `^`, over CORE's `IPow`: integer exponentiation is
# repeated multiplication (a negative exponent yields 0, integer-division
# semantics), the real one is libm's.
$ pow : @use { d: IPow t } -> t -> t -> t = \b e => d.raise b e

# ---- int <-> real conversions ----
# `@cast` crosses only integer widths; these bridge the integer/real boundary
# (a plain numeric cast in the engine runtime). `f32`/`int_of_f32` target the
# 32-bit reals that C graphics APIs use.
$ real_of_int : @Int -> Real = \n => C.i2d n
$ int_of_real : Real -> @Int = \x => C.d2i x
$ f32_of_int : @Int -> @Float32 = \n => C.i2f n
$ int_of_f32 : @Float32 -> @Int = \x => C.f2i x

# ---- Real helpers ----

$ pi : Real = 3.141592653589793
$ euler : Real = 2.718281828459045

# ---- libm (via the C namespace) ----

# ---- elementary functions, as interfaces ----
# Over reals (here) and complex numbers (ARESxCPX) alike.
$ ISqrt : (t: @Type) -> @Type = @struct sqrt: t -> t,
$ sqrt : @use { d: ISqrt t } -> t -> t = \x => d.sqrt x
$ ISin : (t: @Type) -> @Type = @struct sin: t -> t,
$ sin : @use { d: ISin t } -> t -> t = \x => d.sin x
$ ICos : (t: @Type) -> @Type = @struct cos: t -> t,
$ cos : @use { d: ICos t } -> t -> t = \x => d.cos x
$ ITan : (t: @Type) -> @Type = @struct tan: t -> t,
$ tan : @use { d: ITan t } -> t -> t = \x => d.tan x
$ IExp : (t: @Type) -> @Type = @struct exp: t -> t,
$ exp : @use { d: IExp t } -> t -> t = \x => d.exp x
$ ILog : (t: @Type) -> @Type = @struct log: t -> t,
$ log : @use { d: ILog t } -> t -> t = \x => d.log x

$ impl_ISqrt_for_float64 : ISqrt Real = .{ .sqrt = \x => C.sqrt x }
$ impl_ISin_for_float64 : ISin Real = .{ .sin = \x => C.sin x }
$ impl_ICos_for_float64 : ICos Real = .{ .cos = \x => C.cos x }
$ impl_ITan_for_float64 : ITan Real = .{ .tan = \x => C.tan x }
$ impl_IExp_for_float64 : IExp Real = .{ .exp = \x => C.exp x }
$ impl_ILog_for_float64 : ILog Real = .{ .log = \x => C.log x }
$ floor : Real -> Real = \x => C.floor x
$ ceil : Real -> Real = \x => C.ceil x
$ round : Real -> Real = \x => C.round x

$ fmod : Real -> Real -> Real = \a b => C.fmod { a, b }
$ atan2 : Real -> Real -> Real = \y x => C.atan2 { y, x }
