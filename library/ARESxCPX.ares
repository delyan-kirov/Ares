$ @mod ARES

# \file ARESxCPX.ares
# \info Complex-number math over CORE's `Cpx`. The type, the `i` literal and
#       `+ - * /` live in CORE (implicitly imported, so `3.4 + 1.2i` needs no
#       import); everything here is the rest of the surface: parts, polar form,
#       roots, and the transcendentals, all ordinary Ares over libm through the
#       `C` namespace.

$ @import ARESxALGO
$ @import ARESxMATH

# ---- constants ----

$ zero : Cpx = Cpx.{ 0.0, 0.0 }
$ one : Cpx = Cpx.{ 1.0, 0.0 }

# ---- parts and predicates ----

$ re : Cpx -> Real = \z => z.re
$ im : Cpx -> Real = \z => z.im

$ of_real : Real -> Cpx = \x => Cpx.{ x, 0.0 }

$ conj : Cpx -> Cpx = \z => Cpx.{ z.re, 0.0 - z.im }

# `|z|`, via libm `hypot` so a large component does not overflow the squares.
$ magnitude : Cpx -> Real = \z => C.hypot { z.re, z.im }

# `|z|^2`. Cheaper than `magnitude` and exact for exactly-representable parts, which
# is why comparisons and `recip` use it.
$ norm : Cpx -> Real = \z => z.re * z.re + z.im * z.im

# The principal argument, in (-pi, pi].
$ arg : Cpx -> Real = \z => C.atan2 { z.im, z.re }

$ is_real : Cpx -> Bool = \z => z.im == 0.0
$ is_zero : Cpx -> Bool = \z => z.re == 0.0 && z.im == 0.0

# ---- scaling and inversion ----

$ scale : Real -> Cpx -> Cpx = \k z => Cpx.{ k * z.re, k * z.im }

$ recip : Cpx -> Cpx = \z => let d = norm z in Cpx.{ z.re / d, (0.0 - z.im) / d }

# Smith's division: it scales by the smaller of the divisor's parts, so it keeps
# its range where CORE's `/` (which forms `|b|^2` directly) would overflow.
$ div_smith : Cpx -> Cpx -> Cpx = \a b =>
    if abs b.re >= abs b.im =>
        let r = b.im / b.re in
        let d = b.re + b.im * r in
        Cpx.{ (a.re + a.im * r) / d, (a.im - a.re * r) / d }
    else
        let r = b.re / b.im in
        let d = b.re * r + b.im in
        Cpx.{ (a.re * r + a.im) / d, (a.im * r - a.re) / d }

# ---- polar form ----

$ polar : Cpx -> { Real, Real } = \z => { magnitude z, arg z }

$ from_polar : Real -> Real -> Cpx = \r theta => Cpx.{ r * cos theta, r * sin theta }

# ---- transcendentals ----

# `exp z = e^x (cos y + i sin y)`.
$ impl_IExp_for_Cpx : IExp Cpx = .{ .exp = cpx_exp }
$ cpx_exp : Cpx -> Cpx = \z => let m = exp z.re in Cpx.{ m * cos z.im, m * sin z.im }

# The principal branch: the imaginary part is `arg z`, so it lies in (-pi, pi].
$ impl_ILog_for_Cpx : ILog Cpx = .{ .log = cpx_log }
$ cpx_log : Cpx -> Cpx = \z => Cpx.{ log (magnitude z), arg z }

# The principal square root, from the polar form at half the argument.
$ impl_ISqrt_for_Cpx : ISqrt Cpx = .{ .sqrt = cpx_sqrt }
$ cpx_sqrt : Cpx -> Cpx = \z =>
    let r = sqrt (magnitude z) in let half = arg z / 2.0 in Cpx.{ r * cos half, r * sin half }

# `z^w = exp (w * log z)`, principal branch. `0^0` is 1, as for reals.
$ cpx_pow : Cpx -> Cpx -> Cpx = \z w =>
    if is_zero z => (if is_zero w => one else zero) else cpx_exp (w * cpx_log z)

$ powi : @Int -> Cpx -> Cpx = \n z =>
    if n < 0 => recip (powi (0 - n) z) else if n == 0 => one else z * powi (n - 1) z

# `z ^ w` on two complexes goes through CORE's `IPow`. An INTEGER exponent is
# `powi` by name: one operator takes one type for both operands, so a mixed pair is
# not expressible (and `powi` is the faster algorithm anyway).
$ impl_IPow_for_Cpx : IPow Cpx = .{ .raise = cpx_pow }

$ impl_ISin_for_Cpx : ISin Cpx = .{ .sin = cpx_sin }
$ cpx_sin : Cpx -> Cpx = \z => Cpx.{ sin z.re * C.cosh z.im, cos z.re * C.sinh z.im }

$ impl_ICos_for_Cpx : ICos Cpx = .{ .cos = cpx_cos }
$ cpx_cos : Cpx -> Cpx = \z => Cpx.{ cos z.re * C.cosh z.im, 0.0 - (sin z.re * C.sinh z.im) }

$ impl_ITan_for_Cpx : ITan Cpx = .{ .tan = \z => cpx_sin z / cpx_cos z }

$ sinh : Cpx -> Cpx = \z => Cpx.{ C.sinh z.re * cos z.im, C.cosh z.re * sin z.im }

$ cosh : Cpx -> Cpx = \z => Cpx.{ C.cosh z.re * cos z.im, C.sinh z.re * sin z.im }

$ tanh : Cpx -> Cpx = \z => sinh z / cosh z

# ---- roots ----

# The `n`th roots of unity, counter-clockwise from 1. Empty for `n <= 0`.
$ roots_of_unity : @Int -> @Vec Cpx = \n => roots_onto (@vec_new {}) 1.0 0.0 n 0

# The `n` `n`th roots of `z`, counter-clockwise from the principal one. Empty for
# `n <= 0`.
$ roots : @Int -> Cpx -> @Vec Cpx = \n z =>
    let r = pow (magnitude z) (1.0 / C.i2d n) in roots_onto (@vec_new {}) r (arg z / C.i2d n) n 0

$ @private

# The roots share one loop: `n` points on the circle of radius `r`, starting at
# `base` and stepping by a full turn over `n`.
$ roots_onto : @Vec Cpx -> Real -> Real -> @Int -> @Int -> @Vec Cpx = \acc r base n k =>
    if k >= n =>
        acc
    else
        let step = 2.0 * pi * C.i2d k / C.i2d n in
        roots_onto (@vec_push acc (from_polar r (base + step))) r base n (k + 1)
